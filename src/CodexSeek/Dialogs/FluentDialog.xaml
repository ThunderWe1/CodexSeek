<ui:FluentWindow x:Class="CodexSeek.Dialogs.FluentDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="540"
                 MinHeight="0"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="Microsoft YaHei UI"
                 FontSize="13"
                 TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
                 x:Name="DialogTitleBar"
                 Title="提示"
                 ShowMinimize="False"
                 ShowMaximize="False"
                 ShowClose="True" />

    <StackPanel Grid.Row="1" Margin="28,12,28,24">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="IconBorder"
                Width="42"
                Height="42"
                CornerRadius="11"
                Background="#2563EB">
          <ui:SymbolIcon x:Name="DialogIcon"
                         Symbol="Info24"
                         FontSize="21"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
        </Border>

        <TextBlock Grid.Column="1"
                   x:Name="MessageText"
                   Margin="16,0,0,0"
                   FontSize="14"
                   LineHeight="24"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      </Grid>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,24,0,0">
        <ui:Button x:Name="SecondaryButton"
                   Content="取消"
                   Appearance="Secondary"
                   MinWidth="100"
                   Margin="0,0,10,0"
                   Click="SecondaryButton_Click" />
        <ui:Button x:Name="PrimaryButton"
                   Content="确定"
                   Appearance="Primary"
                   MinWidth="100"
                   Click="PrimaryButton_Click" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
