<ui:FluentWindow x:Class="CodexSeek.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="CodexSeek"
                 Width="640"
                 SizeToContent="Height"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="Microsoft YaHei UI"
                 FontSize="13"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
                 Title="CodexSeek"
                 ShowMinimize="True"
                 ShowMaximize="False"
                 ShowClose="True">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="ArrowSwap24" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,6,24,18">
      <StackPanel>

        <!-- Hero banner: mascot + current model + the one primary action -->
        <Border x:Name="BannerSurface"
                Height="168"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image x:Name="MascotImage"
                   Grid.Column="0"
                   Width="166"
                   Height="166"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="Collapsed"
                   IsHitTestVisible="False">
              <Image.Effect>
                <DropShadowEffect BlurRadius="22"
                                  Direction="270"
                                  ShadowDepth="5"
                                  Opacity="0.12"
                                  Color="Black" />
              </Image.Effect>
            </Image>

            <StackPanel Grid.Column="1"
                        Margin="18,0,14,0"
                        VerticalAlignment="Center">
              <TextBlock Text="当前模型"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="CurrentModeText"
                         Text="未知"
                         Margin="0,2,0,0"
                         FontSize="26"
                         FontWeight="SemiBold" />
              <TextBlock x:Name="CurrentModelText"
                         Text="（未设置）"
                         Margin="0,2,0,0"
                         FontSize="12"
                         MaxWidth="240"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0">
              <ui:ProgressRing x:Name="BusyRing"
                               Width="18"
                               Height="18"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               IsIndeterminate="True"
                               Visibility="Collapsed" />
              <ui:Button x:Name="SwitchButton"
                         Content="切换到 GPT"
                         Appearance="Primary"
                         Width="172"
                         Height="46"
                         FontSize="14"
                         Click="SwitchButton_Click">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="ArrowSwap24" />
                </ui:Button.Icon>
              </ui:Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- First-run setup -->
        <ui:Card x:Name="SetupCard"
                 Margin="0,12,0,0"
                 Visibility="Collapsed">
          <StackPanel Margin="16">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Key24"
                             FontSize="18"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <TextBlock Text="初始化 DeepSeek"
                         Margin="8,0,0,0"
                         FontSize="15"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>

            <Grid Margin="0,12,0,0">
              <ui:PasswordBox x:Name="SetupKeyBox"
                              Height="38"
                              RevealButtonEnabled="True"
                              FontFamily="Consolas"
                              FontSize="13" />
              <TextBlock x:Name="SetupKeyPlaceholder"
                         Text="请输入 DeepSeek API Key（形如 sk-xxxxxxxx）"
                         Margin="12,0,46,0"
                         VerticalAlignment="Center"
                         FontSize="13"
                         TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <ui:Button x:Name="SetupButton"
                       Content="导入并完成设置"
                       Appearance="Primary"
                       Height="42"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Stretch"
                       Click="SetupButton_Click">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="ArrowDownload24" />
              </ui:Button.Icon>
            </ui:Button>
          </StackPanel>
        </ui:Card>

        <!-- Ready state -->
        <StackPanel x:Name="MainContent" Visibility="Collapsed">

          <!-- Status card -->
          <ui:Card Margin="0,12,0,0">
            <StackPanel Margin="16,14,16,16">
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Info24"
                                 FontSize="18"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  <TextBlock Text="当前状态"
                             Margin="8,0,0,0"
                             FontSize="15"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button x:Name="RefreshButton"
                           Content="刷新状态"
                           Appearance="Secondary"
                           HorizontalAlignment="Right"
                           Click="RefreshButton_Click">
                  <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                  </ui:Button.Icon>
                </ui:Button>
              </Grid>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="环境" Margin="0,0,0,7"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,7">
                  <Ellipse x:Name="EnvDot"
                           Width="7"
                           Height="7"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                  <TextBlock x:Name="EnvStatusText" Text="已就绪"
                             Margin="6,0,0,0" FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Codex App" Margin="0,0,0,7"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,7">
                  <Ellipse x:Name="AppDot"
                           Width="7"
                           Height="7"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                  <TextBlock x:Name="AppStatusText" Text="未运行"
                             Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="配置文件" Margin="0,0,0,7"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Row="2" Grid.Column="1"
                           x:Name="ConfigPathButton"
                           Appearance="Transparent"
                           Padding="0"
                           Margin="0,0,0,7"
                           HorizontalAlignment="Left"
                           HorizontalContentAlignment="Left"
                           Click="ConfigPathButton_Click">
                  <TextBlock x:Name="ConfigPathText"
                             Text="—"
                             MaxWidth="410"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:Button>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="模型目录"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Row="3" Grid.Column="1"
                           x:Name="CatalogPathButton"
                           Appearance="Transparent"
                           Padding="0"
                           HorizontalAlignment="Left"
                           HorizontalContentAlignment="Left"
                           Click="CatalogPathButton_Click">
                  <TextBlock x:Name="CatalogPathText"
                             Text="—"
                             MaxWidth="410"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:Button>
              </Grid>
            </StackPanel>
          </ui:Card>

          <!-- API key card -->
          <ui:Card Margin="0,12,0,0">
            <StackPanel Margin="16,14,16,16">
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Key24"
                                 FontSize="18"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  <TextBlock Text="DeepSeek API Key"
                             Margin="8,0,0,0"
                             FontSize="15"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="KeyHintText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Grid>

              <Grid Margin="0,12,0,0">
                <ui:PasswordBox x:Name="ApiKeyBox"
                                Height="36"
                                RevealButtonEnabled="True"
                                FontFamily="Consolas"
                                FontSize="13" />
                <TextBlock x:Name="ApiKeyPlaceholder"
                           Text="请输入 DeepSeek API Key（形如 sk-xxxxxxxx）"
                           Margin="12,0,46,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button x:Name="SaveKeyButton"
                           Content="保存 API Key"
                           Appearance="Primary"
                           Click="SaveKeyButton_Click">
                  <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                  </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="TestKeyButton"
                           Content="测试连接"
                           Appearance="Secondary"
                           Margin="10,0,0,0"
                           Click="TestKeyButton_Click">
                  <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="PlugConnected24" />
                  </ui:Button.Icon>
                </ui:Button>
              </StackPanel>
            </StackPanel>
          </ui:Card>

        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</ui:FluentWindow>
