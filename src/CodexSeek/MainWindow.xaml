<ui:FluentWindow x:Class="CodexSeek.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="CodexSeek"
                 Width="900"
                 Height="800"
                 MinWidth="780"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="Microsoft YaHei UI"
                 FontSize="13"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <ui:TitleBar Grid.Row="0"
                 Grid.ColumnSpan="2"
                 Title="CodexSeek"
                 ShowMinimize="True"
                 ShowMaximize="False"
                 ShowClose="True">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="ArrowSwap24" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Current-model mascot: bottom-right corner, changes with the active model -->
    <Image x:Name="MascotImage"
           Grid.Row="1"
           Grid.RowSpan="2"
           Grid.Column="1"
           Width="310"
           Height="310"
           Margin="0,0,10,4"
           HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Stretch="Uniform"
           RenderOptions.BitmapScalingMode="HighQuality"
           Visibility="Collapsed"
           IsHitTestVisible="False">
      <Image.Effect>
        <DropShadowEffect BlurRadius="26"
                          Direction="270"
                          ShadowDepth="7"
                          Opacity="0.15"
                          Color="Black" />
      </Image.Effect>
    </Image>

    <ScrollViewer Grid.Row="1"
                  Grid.Column="0"
                  VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="28,10,28,6">
      <StackPanel MaxWidth="560">


        <!-- First-run setup -->
        <ui:Card x:Name="SetupCard"
                 Margin="0,14,0,0"
                 Visibility="Collapsed">
          <StackPanel Margin="16">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Key24"
                             FontSize="18"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <TextBlock Text="初始化 DeepSeek"
                         Margin="8,0,0,0"
                         FontSize="16"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>

            <Grid Margin="0,14,0,0">
              <ui:PasswordBox x:Name="SetupKeyBox"
                              Height="40"
                              RevealButtonEnabled="True"
                              FontFamily="Consolas"
                              FontSize="13" />
              <TextBlock x:Name="SetupKeyPlaceholder"
                         Text="请输入 DeepSeek API Key（形如 sk-xxxxxxxx）"
                         Margin="12,0,46,0"
                         VerticalAlignment="Center"
                         FontSize="13"
                         TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <ui:Button x:Name="SetupButton"
                       Content="导入并完成设置"
                       Appearance="Primary"
                       Width="220"
                       Height="44"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Click="SetupButton_Click">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="ArrowDownload24" />
              </ui:Button.Icon>
            </ui:Button>
          </StackPanel>
        </ui:Card>

        <!-- Ready state -->
        <StackPanel x:Name="MainContent" Visibility="Collapsed">

          <!-- Switch card -->
          <ui:Card Margin="0,14,0,0">
            <StackPanel Margin="16">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowSwap24"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="切换模型"
                           Margin="8,0,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>

              <ui:Button x:Name="SwitchButton"
                         Appearance="Primary"
                         Width="300"
                         Height="48"
                         Margin="0,14,0,0"
                         HorizontalAlignment="Center"
                         FontSize="15"
                         Click="SwitchButton_Click">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="ArrowSwap24" />
                </ui:Button.Icon>
              </ui:Button>
            </StackPanel>
          </ui:Card>

          <!-- Status card -->
          <ui:Card Margin="0,12,0,0">
            <StackPanel Margin="16">
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Info24"
                                 FontSize="18"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  <TextBlock Text="当前状态"
                             Margin="8,0,0,0"
                             FontSize="16"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button x:Name="RefreshButton"
                           Content="刷新状态"
                           Appearance="Secondary"
                           HorizontalAlignment="Right"
                           Click="RefreshButton_Click">
                  <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                  </ui:Button.Icon>
                </ui:Button>
              </Grid>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="当前模型" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock x:Name="CurrentModeText" Text="未知" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock x:Name="CurrentModelText" Text="（未设置）" Margin="10,0,0,0"
                             MaxWidth="420" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="DeepSeek 环境" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EnvStatusText" Text="已就绪"
                           Margin="0,0,0,6" FontWeight="SemiBold" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Codex 桌面 App" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AppStatusText" Text="未运行"
                           Margin="0,0,0,6" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="配置文件" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Row="3" Grid.Column="1"
                           x:Name="ConfigPathButton"
                           Appearance="Transparent"
                           Padding="0"
                           Margin="0,0,0,6"
                           HorizontalAlignment="Left"
                           HorizontalContentAlignment="Left"
                           Click="ConfigPathButton_Click">
                  <TextBlock x:Name="ConfigPathText"
                             Text="—"
                             MaxWidth="580"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:Button>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="模型目录" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Row="4" Grid.Column="1"
                           x:Name="CatalogPathButton"
                           Appearance="Transparent"
                           Padding="0"
                           Margin="0,0,0,6"
                           HorizontalAlignment="Left"
                           HorizontalContentAlignment="Left"
                           Click="CatalogPathButton_Click">
                  <TextBlock x:Name="CatalogPathText"
                             Text="—"
                             MaxWidth="580"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:Button>

              </Grid>
            </StackPanel>
          </ui:Card>

          <!-- API key card -->
          <ui:Card Margin="0,12,0,0">
            <StackPanel Margin="16">
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Key24"
                                 FontSize="18"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  <TextBlock Text="DeepSeek API Key"
                             Margin="8,0,0,0"
                             FontSize="16"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="KeyHintText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Grid>

              <Grid Margin="0,11,0,0">
                <ui:PasswordBox x:Name="ApiKeyBox"
                                Height="36"
                                RevealButtonEnabled="True"
                                FontFamily="Consolas"
                                FontSize="13" />
                <TextBlock x:Name="ApiKeyPlaceholder"
                           Text="请输入 DeepSeek API Key（形如 sk-xxxxxxxx）"
                           Margin="12,0,46,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                <ui:Button x:Name="SaveKeyButton"
                           Content="保存 API Key"
                           Appearance="Primary"
                           Click="SaveKeyButton_Click">
                  <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                  </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="TestKeyButton"
                           Content="测试连接"
                           Appearance="Secondary"
                           Margin="10,0,0,0"
                           Click="TestKeyButton_Click">
                  <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="PlugConnected24" />
                  </ui:Button.Icon>
                </ui:Button>
              </StackPanel>
            </StackPanel>
          </ui:Card>

          <Grid Margin="0,10,0,0">
            <ui:Button Content="关闭"
                       Appearance="Secondary"
                       HorizontalAlignment="Right"
                       Click="CloseButton_Click" />
          </Grid>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="28,0,28,10"
            Background="Transparent">
      <ui:ProgressRing x:Name="BusyRing"
                       Width="16"
                       Height="16"
                       HorizontalAlignment="Left"
                       IsIndeterminate="True"
                       Visibility="Collapsed" />
    </Border>

  </Grid>
</ui:FluentWindow>
